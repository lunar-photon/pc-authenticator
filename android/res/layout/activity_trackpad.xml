<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_trackpad_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖱️ Remote Trackpad"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_white" />

            <TextView
                android:id="@+id/tv_trackpad_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target: cachyos-x8664"
                android:textSize="12sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_trackpad_keyboard"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="⌨️ Type"
            android:textSize="13sp"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- Speed / Sensitivity Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tv_sensitivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sensitivity: 1.2x"
            android:textSize="12sp"
            android:textColor="@color/accent_cyan" />

        <Button
            android:id="@+id/btn_sens_down"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="-"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_sens_up"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="+"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg" />
    </LinearLayout>

    <!-- Mode Switcher Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btn_mode_trackpad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🖱️ Touchpad"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/accent_cyan"
            android:background="@drawable/card_bg"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_mode_pointer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🎯 Laser Pointer"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:background="@drawable/card_bg"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Main Touchpad Surface -->
    <FrameLayout
        android:id="@+id/touchpad_surface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/trackpad_surface"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Touchpad Surface"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☝️ 1 Finger: Move Pointer  •  Tap: Left Click"
                android:textSize="11sp"
                android:textColor="#64748b" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✌️ 2 Fingers: Scroll  •  Tap: Right Click"
                android:textSize="11sp"
                android:textColor="#64748b"
                android:layout_marginTop="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👆 Hold &amp; Drag: Select / Drag and Drop"
                android:textSize="11sp"
                android:textColor="#64748b"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Laser Pointer Surface (Presentation Remote) -->
    <LinearLayout
        android:id="@+id/layout_pointer_surface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:background="@drawable/trackpad_surface"
        android:padding="16dp">

        <!-- Big Hold-to-Aim Laser Button -->
        <FrameLayout
            android:id="@+id/btn_laser_aim"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/btn_laser_idle"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_laser_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 HOLD TO POINT"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#ef4444" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Move phone in the air to control laser pointer"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Lock Gyro Toggle -->
        <Button
            android:id="@+id/btn_lock_gyro"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="🔒 Lock Pointer ON"
            android:textSize="12sp"
            android:textColor="@color/text_muted"
            android:background="@drawable/card_bg"
            android:layout_marginTop="10dp" />

        <!-- Presentation Slide Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_slide_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="◀ Prev"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_slide_f5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="▶ Slide (F5)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent_cyan"
                android:background="@drawable/card_bg"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_slide_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Next ▶"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Buttons: Left Click & Right Click -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_click_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="LEFT CLICK"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_click_middle"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:text="MID"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:background="@drawable/card_bg"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_click_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="RIGHT CLICK"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg" />
    </LinearLayout>

</LinearLayout>
