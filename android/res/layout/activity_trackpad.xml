<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btn_trackpad_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖱️ Trackpad &amp; Laser"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/text_white" />

            <TextView
                android:id="@+id/tv_trackpad_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target: cachyos-x8664"
                android:textSize="12sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_trackpad_keyboard"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="⌨️ Type"
            android:textSize="13sp"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- Speed / Sensitivity Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tv_sensitivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sensitivity: 1.2x"
            android:textSize="12sp"
            android:textColor="@color/accent_cyan" />

        <Button
            android:id="@+id/btn_sens_down"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="-"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_sens_up"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="+"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg" />
    </LinearLayout>

    <!-- Main Touchpad Surface -->
    <FrameLayout
        android:id="@+id/touchpad_surface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/trackpad_surface"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Touchpad Surface"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#475569"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☝️ 1 Finger: Move Cursor  •  Tap: Left Click"
                android:textSize="11sp"
                android:textColor="#64748b" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✌️ 2 Fingers: Scroll  •  Tap: Right Click"
                android:textSize="11sp"
                android:textColor="#64748b"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Remote Keyboard Panel (Collapsible) -->
    <LinearLayout
        android:id="@+id/layout_keyboard_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <!-- Live Typing Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <EditText
                android:id="@+id/et_keyboard_input"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Type on phone to type on PC..."
                android:textSize="13sp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/card_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:imeOptions="actionSend" />

            <Button
                android:id="@+id/btn_key_send_text"
                android:layout_width="54dp"
                android:layout_height="40dp"
                android:text="Send"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_approve"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Function Keys Row 1: Esc, Tab, Win, Bksp, Enter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btn_key_esc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Esc"
                android:textSize="11sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_key_tab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Tab"
                android:textSize="11sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_key_super"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⊞ Win"
                android:textSize="11sp"
                android:textColor="@color/accent_cyan"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_key_backspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="⌫ Bksp"
                android:textSize="11sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_key_enter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:text="↵ Enter"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/accent_cyan"
                android:background="@drawable/card_bg" />
        </LinearLayout>

        <!-- Function Keys Row 2: Shortcuts & Navigation Arrows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_key_ctrl_c"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Ctrl+C"
                android:textSize="10sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_key_ctrl_v"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Ctrl+V"
                android:textSize="10sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_key_ctrl_z"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Ctrl+Z"
                android:textSize="10sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_key_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:text="←"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_key_up"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:text="↑"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_key_down"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:text="↓"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/btn_key_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:text="→"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg" />
        </LinearLayout>
    </LinearLayout>

    <!-- Laser Pointer Bar & Slide Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <!-- Presentation Slide Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_slide_prev"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="◀ Prev"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_slide_f5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="▶ Slide (F5)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/accent_cyan"
                android:background="@drawable/card_bg"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_slide_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Next ▶"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Laser Pointer Hold & Lock Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/btn_laser_aim"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_laser_idle"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/tv_laser_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🔴 HOLD TO POINT"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ef4444" />
            </FrameLayout>

            <Button
                android:id="@+id/btn_lock_gyro"
                android:layout_width="88dp"
                android:layout_height="match_parent"
                android:text="🔒 Lock"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:background="@drawable/card_bg" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Buttons: Left Click & Right Click -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_click_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="LEFT CLICK"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_click_middle"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:text="MID"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:background="@drawable/card_bg"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_click_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="RIGHT CLICK"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg" />
    </LinearLayout>

</LinearLayout>
