<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg_dark"
    android:padding="14dp">

    <!-- Header & Storage info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📁 Laptop Storage Browser"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_white" />

        <TextView
            android:id="@+id/tv_browser_storage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading storage..."
            android:textSize="11sp"
            android:textColor="@color/accent_cyan" />
    </LinearLayout>

    <!-- Path Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_browse_home"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:text="🏠"
            android:textSize="14sp"
            android:background="@drawable/card_bg"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_browse_up"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="⬆ Up"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg"
            android:layout_marginEnd="4dp" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/card_bg"
            android:scrollbars="none"
            android:layout_marginEnd="4dp">

            <TextView
                android:id="@+id/tv_browse_path"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="~"
                android:textSize="11sp"
                android:textColor="@color/text_white"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/btn_browse_refresh"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:text="🔄"
            android:textSize="13sp"
            android:background="@drawable/card_bg" />
    </LinearLayout>

    <!-- Quick Shortcuts Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_shortcut_drives"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="💾 Drives &amp; Disks"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/accent_cyan"
                android:background="@drawable/card_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_shortcut_downloads"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="📥 Downloads"
                android:textSize="10sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_shortcut_documents"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="📄 Documents"
                android:textSize="10sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_shortcut_pictures"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="🖼️ Pictures"
                android:textSize="10sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_shortcut_videos"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="🎬 Videos"
                android:textSize="10sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_shortcut_desktop"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="💻 Desktop"
                android:textSize="10sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Content Items Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="280dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/container_browse_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <ProgressBar
            android:id="@+id/pb_browse_loading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_browse_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📁 Directory is empty"
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
