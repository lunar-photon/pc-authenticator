<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_camera_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📹 PC Camera Live"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_white" />

            <TextView
                android:id="@+id/tv_camera_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target: cachyos-x8664"
                android:textSize="12sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_camera_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 LIVE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#10b981"
            android:background="@drawable/card_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <!-- Camera Viewport Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/trackpad_surface"
        android:clipChildren="true">

        <ImageView
            android:id="@+id/iv_camera_feed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true" />

        <ProgressBar
            android:id="@+id/pb_camera_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tv_camera_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Connecting to PC Camera..."
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="20dp" />
    </FrameLayout>

    <!-- Control Actions Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp">

        <!-- Main Action Buttons: Take Snapshot & Switch Camera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_camera_snapshot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:text="📸 Take Snapshot"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_approve"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_camera_switch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🔄 Switch"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg" />
        </LinearLayout>

        <!-- Secondary Controls: Pause & Quality -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_camera_play_pause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⏸ Pause Stream"
                android:textSize="12sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_camera_quality"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="⚙️ Quality: Smooth"
                android:textSize="12sp"
                android:textColor="@color/accent_cyan"
                android:background="@drawable/card_bg"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
