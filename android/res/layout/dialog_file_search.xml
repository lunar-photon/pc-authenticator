<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_bg_dark"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔍 Search Laptop Files"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_white"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <EditText
            android:id="@+id/et_search_query"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Filename (e.g. pdf, notes, doc)..."
            android:textSize="13sp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:background="@drawable/card_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <Button
            android:id="@+id/btn_search_submit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Search"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/btn_approve"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_search_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter a query to search files on laptop"
        android:textSize="11sp"
        android:textColor="@color/accent_cyan"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="240dp">

        <LinearLayout
            android:id="@+id/container_search_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
