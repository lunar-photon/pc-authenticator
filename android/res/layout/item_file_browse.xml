<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_bg"
    android:padding="8dp"
    android:layout_marginBottom="4dp">

    <TextView
        android:id="@+id/tv_browse_item_icon"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:text="📁"
        android:textSize="18sp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/tv_browse_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Folder or File Name"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tv_browse_item_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Folder • 2026-09-30"
            android:textSize="10sp"
            android:textColor="@color/text_muted"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_browse_item_action"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Open"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <Button
            android:id="@+id/btn_browse_item_download"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="📥"
            android:textSize="11sp"
            android:textColor="@color/text_white"
            android:background="@drawable/card_bg"
            android:layout_marginStart="4dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
