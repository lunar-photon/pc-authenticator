<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔗 PC Connect"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Linux Desktop Connect &amp; 2FA Suite"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="⚙️"
                android:textSize="18sp"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg" />
        </LinearLayout>

        <!-- Active Connected Device Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE TARGET LAPTOP"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/accent_cyan" />

            <TextView
                android:id="@+id/tv_hostname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="cachyos-x8664"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tv_active_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="http://192.168.48.40:1760"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tv_status_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● "
                    android:textSize="18sp"
                    android:textColor="@color/status_green" />

                <TextView
                    android:id="@+id/tv_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connected &amp; Listening"
                    android:textSize="13sp"
                    android:textColor="@color/text_white" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_test_connection"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="⚡ Ping Current Laptop"
                android:textSize="13sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_approve"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Laptop Live Status & Remote Controls Card -->
        <LinearLayout
            android:id="@+id/layout_laptop_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💻 LAPTOP LIVE STATUS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_cyan" />

                <TextView
                    android:id="@+id/tv_pc_lock_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔓 Unlocked"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_green" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/tv_pc_battery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔋 Battery: --%"
                    android:textSize="12sp"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/tv_pc_uptime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️ Uptime: --"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tv_pc_cpu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📊 CPU: --%"
                    android:textSize="12sp"
                    android:textColor="@color/text_white" />

                <TextView
                    android:id="@+id/tv_pc_memory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💾 RAM: --"
                    android:textSize="12sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tv_pc_storage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💽 Disk: -- GB free / -- GB"
                    android:textSize="12sp"
                    android:textColor="@color/text_white" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_pc_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌤️ Weather: Loading..."
                android:textSize="12sp"
                android:textColor="@color/accent_cyan"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btn_lock_laptop_action"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="🔒 Lock Screen"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:background="@drawable/btn_deny"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_screenshot_action"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="📸 Screen View"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btn_browse_laptop_action"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="📁 Browse Storage"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_search_files_action"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="🔍 Search Files"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg" />
            </LinearLayout>
        </LinearLayout>

        <!-- Active Challenge Card -->
        <LinearLayout
            android:id="@+id/layout_challenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ UNLOCK CHALLENGE ACTIVE"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/accent_cyan" />

            <TextView
                android:id="@+id/tv_challenge_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login requested on your laptop. Approve to unlock."
                android:textSize="16sp"
                android:textColor="@color/text_white"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expires in: 35s"
                android:textSize="14sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btn_approve_challenge"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="👆 APPROVE WITH FINGERPRINT"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_approve"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btn_deny_challenge"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="❌ DENY"
                android:textSize="14sp"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_deny"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- File Sharing & Quick Actions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 FILE SHARING &amp; QUICK ACTIONS"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/accent_cyan" />

            <Button
                android:id="@+id/btn_send_file_to_pc"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="📤 Send File to PC"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/btn_approve"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_send_clip_to_pc"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="📋 Copy to PC"
                    android:textSize="12sp"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_get_clip_from_pc"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="📋 Paste from PC"
                    android:textSize="12sp"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_ring_pc"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="🔔 Ring Laptop"
                    android:textSize="12sp"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_camera_view"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="📹 PC Camera"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_remote_trackpad"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="🖱️ Trackpad &amp; Laser"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:background="@drawable/card_bg"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Media Player Remote Card -->
        <LinearLayout
            android:id="@+id/layout_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎵 PC MEDIA PLAYER"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_cyan" />

                <TextView
                    android:id="@+id/tv_media_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking..."
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_media_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No media active on PC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tv_media_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <!-- Media Playback Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btn_media_prev"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:text="⏮"
                    android:textSize="16sp"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_media_play_pause"
                    android:layout_width="60dp"
                    android:layout_height="44dp"
                    android:text="⏯"
                    android:textSize="18sp"
                    android:textColor="@color/text_white"
                    android:background="@drawable/btn_approve"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_media_next"
                    android:layout_width="48dp"
                    android:layout_height="44dp"
                    android:text="⏭"
                    android:textSize="16sp"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg"
                    android:layout_marginEnd="12dp" />

                <Button
                    android:id="@+id/btn_media_voldown"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="🔉"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_media_volup"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="🔊"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg" />
            </LinearLayout>
        </LinearLayout>

        <!-- Paired Devices Management Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="PAIRED LAPTOPS &amp; PCS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_cyan" />

                <TextView
                    android:id="@+id/tv_device_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 Saved"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <!-- Buttons: Auto Scan & Add Manually -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btn_scan_network"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="🔍 Auto-Scan Wi-Fi"
                    android:textSize="12sp"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_add_manual"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="➕ Add PC Manually"
                    android:textSize="12sp"
                    android:textColor="@color/text_white"
                    android:background="@drawable/card_bg"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Scanning Indicator -->
            <TextView
                android:id="@+id/tv_scan_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scanning local network for laptops..."
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:gravity="center"
                android:padding="8dp"
                android:visibility="gone" />

            <!-- Dynamic List Container for Paired Devices -->
            <LinearLayout
                android:id="@+id/container_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Idle Status Card -->
        <LinearLayout
            android:id="@+id/layout_idle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready to Authenticate"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap 'Select' on any laptop above to switch which PC to approve. When screen locks, an approval prompt appears instantly."
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
