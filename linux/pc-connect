#!/usr/bin/env python3
import sys
import os
import json
import urllib.request
import urllib.error
import subprocess

DAEMON_URL = "http://127.0.0.1:1760"

def get_json(endpoint):
    try:
        req = urllib.request.Request(f"{DAEMON_URL}{endpoint}")
        with urllib.request.urlopen(req, timeout=3) as resp:
            return json.loads(resp.read().decode('utf-8'))
    except Exception as e:
        return {"error": str(e)}

def post_json(endpoint, data=None):
    try:
        req_data = json.dumps(data or {}).encode('utf-8')
        req = urllib.request.Request(f"{DAEMON_URL}{endpoint}", data=req_data, headers={'Content-Type': 'application/json'}, method='POST')
        with urllib.request.urlopen(req, timeout=5) as resp:
            return json.loads(resp.read().decode('utf-8'))
    except Exception as e:
        return {"error": str(e)}

def print_help():
    print("""📱 PC Connect - KDE Connect Replacement & Authenticator CLI

Usage:
  pc-connect status                  Check phone connection & battery
  pc-connect browse [path]           Open Phone File Explorer GUI
  pc-connect send <file1> [file2...] Send files to connected phone
  pc-connect ring                    Ring phone loudly (Find My Phone)
  pc-connect ping                    Play chime & notification on PC
  pc-connect clip [text]             Sync clipboard (or send custom text)
  pc-connect media [command]         Control PC playback (play, pause, next, prev, volup, voldown)
  pc-connect lock                    Lock PC screen immediately
  pc-connect pair                    Request pairing PIN for new phone
  pc-connect tray                    Launch native KDE system tray app
""")

def cmd_status():
    st = get_json("/api/phone/status")
    if "error" in st:
        print(f"❌ PC Authenticator daemon is unreachable: {st['error']}")
        return
    phone = st.get("phone", {})
    connected = st.get("connected", False)
    conn_str = "🟢 Connected" if connected else "⚪ Offline / Idle"
    print("==================================================")
    print("  PC Connect Status")
    print("==================================================")
    print(f"  Phone Name:  {phone.get('client_name', 'Unknown')}")
    print(f"  Status:      {conn_str}")
    print(f"  IP Address:  {phone.get('ip', 'Not detected')}")
    if phone.get('battery_level') is not None:
        charging = " ⚡ (Charging)" if phone.get('is_charging') else ""
        print(f"  Battery:     {phone.get('battery_level')}%{charging}")
    print(f"  Paired PCs:  {st.get('clients_count', 0)}")
    print("==================================================")

def cmd_browse(args):
    # Check if PyQt6 GUI is preferred
    gui_script = os.path.expanduser("~/.local/bin/pc-connect-tray.py")
    if "--web" in args or not os.path.exists(gui_script):
        url = f"{DAEMON_URL}/browse"
        print(f"Opening Web Phone Explorer: {url}")
        subprocess.Popen(["xdg-open", url])
    else:
        subprocess.Popen(["python3", gui_script, "--browse"])

def cmd_ring():
    res = post_json("/api/ring")
    print("🔔 Ring command sent to phone! Check your device.")

def cmd_ping():
    res = post_json("/api/ping")
    print("🔔 PC Ping sound triggered.")

def cmd_clip(args):
    if args:
        text = " ".join(args)
        res = post_json("/api/clipboard", {"text": text})
        print("📋 Sent custom text to clipboard.")
    else:
        # Get current PC clipboard and push to phone
        st = get_json("/api/clipboard")
        text = st.get("text", "")
        if text:
            post_json("/api/clipboard", {"text": text})
            print(f"📋 Pushed PC clipboard ({len(text)} chars) to phone!")
        else:
            print("📋 PC clipboard is currently empty.")

def cmd_media(args):
    if not args:
        st = get_json("/api/media/status")
        if not st.get("has_player"):
            print("🎵 No active media player found.")
            return
        status = "▶️ Playing" if st.get("status") == "Playing" else "⏸️ Paused"
        print(f"{status}: {st.get('title')} - {st.get('artist')}")
        return

    sub = args[0].lower()
    mapping = {
        "play": "Play",
        "pause": "Pause",
        "toggle": "PlayPause",
        "playpause": "PlayPause",
        "next": "Next",
        "prev": "Previous",
        "previous": "Previous",
        "stop": "Stop",
        "volup": "VolumeUp",
        "voldown": "VolumeDown"
    }
    cmd = mapping.get(sub, "PlayPause")
    res = post_json("/api/media/command", {"command": cmd})
    print(f"🎵 Media command '{cmd}' executed.")

def cmd_lock():
    post_json("/api/action", {"action": "lock"})
    print("🔒 PC screen locked.")

def cmd_tray():
    gui_script = os.path.expanduser("~/.local/bin/pc-connect-tray.py")
    if os.path.exists(gui_script):
        subprocess.Popen(["python3", gui_script])
    else:
        print("Tray app script not found.")

def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(0)

    cmd = sys.argv[1].lower()
    args = sys.argv[2:]

    if cmd in ("status", "-s", "--status"):
        cmd_status()
    elif cmd in ("browse", "files", "explorer"):
        cmd_browse(args)
    elif cmd in ("send", "upload", "share"):
        send_bin = os.path.expanduser("~/.local/bin/pc-connect-send")
        if os.path.exists(send_bin):
            subprocess.run([send_bin] + args)
        else:
            print("pc-connect-send not found.")
    elif cmd in ("ring", "find"):
        cmd_ring()
    elif cmd in ("ping",):
        cmd_ping()
    elif cmd in ("clip", "clipboard", "copy"):
        cmd_clip(args)
    elif cmd in ("media", "player", "music"):
        cmd_media(args)
    elif cmd in ("lock",):
        cmd_lock()
    elif cmd in ("pair",):
        post_json("/api/pair/request", {"client_name": "Terminal CLI"})
        print("Pairing PIN requested. Check your desktop notifications.")
    elif cmd in ("tray",):
        cmd_tray()
    elif cmd in ("help", "-h", "--help"):
        print_help()
    else:
        print(f"Unknown command: {cmd}")
        print_help()

if __name__ == '__main__':
    main()
