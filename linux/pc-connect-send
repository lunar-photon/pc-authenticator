#!/usr/bin/env python3
import os
import sys
import json
import urllib.request
import urllib.error
from urllib.parse import quote, unquote, urlparse
import subprocess
import time

DAEMON_URL = "http://127.0.0.1:1760"

def notify(title, msg, icon="smartphone", urgency="normal"):
    try:
        subprocess.Popen(['notify-send', '-i', icon, '-a', 'PC Connect', '-u', urgency, title, msg], stderr=subprocess.DEVNULL)
    except Exception:
        pass

def get_phone_status():
    try:
        req = urllib.request.Request(f"{DAEMON_URL}/api/phone/status")
        with urllib.request.urlopen(req, timeout=3) as resp:
            return json.loads(resp.read().decode('utf-8'))
    except Exception:
        return None

def choose_device_gui(devices):
    if not devices:
        return None
    if len(devices) == 1:
        return devices[0]

    # Multiple devices: prompt user with native kdialog
    try:
        args = ["kdialog", "--radiolist", "Select device to send file(s) to:"]
        for idx, dev in enumerate(devices):
            tag = str(idx)
            name = f"{dev.get('client_name', 'Android Phone')} ({dev.get('ip', 'Unknown IP')})"
            status = "on" if idx == 0 else "off"
            args.extend([tag, name, status])
        res = subprocess.run(args, capture_output=True, text=True, timeout=30)
        if res.returncode == 0 and res.stdout.strip():
            sel_idx = int(res.stdout.strip())
            return devices[sel_idx]
        return None
    except Exception:
        return devices[0]

def send_file(filepath, phone_ip, phone_port=1761):
    fn = os.path.basename(filepath)
    size = os.path.getsize(filepath)

    # 1. Try direct HTTP upload to phone file server if IP is known
    if phone_ip:
        try:
            url = f"http://{phone_ip}:{phone_port}/api/files/upload?path={quote('/storage/emulated/0/Download')}"
            with open(filepath, 'rb') as f:
                data = f.read()
            req = urllib.request.Request(
                url,
                data=data,
                headers={
                    'Content-Type': 'application/octet-stream',
                    'Content-Length': str(size),
                    'X-Filename': quote(fn)
                },
                method='POST'
            )
            with urllib.request.urlopen(req, timeout=30) as resp:
                if resp.status == 200:
                    return True
        except Exception:
            pass

    # 2. Try local daemon upload proxy (PC -> Daemon -> Phone)
    try:
        url = f"{DAEMON_URL}/api/phone/files/upload?path={quote('/storage/emulated/0/Download')}"
        with open(filepath, 'rb') as f:
            data = f.read()
        req = urllib.request.Request(
            url,
            data=data,
            headers={
                'Content-Type': 'application/octet-stream',
                'Content-Length': str(size),
                'X-Filename': quote(fn)
            },
            method='POST'
        )
        with urllib.request.urlopen(req, timeout=30) as resp:
            if resp.status == 200:
                return True
    except Exception:
        pass

    # 3. Fallback to staging download URL pushed via NDJSON
    try:
        res = stage_file_fallback(filepath)
        if res.get('status') == 'ok':
            return True
    except Exception:
        pass

    return False

def stage_file_fallback(filepath):
    req_data = json.dumps({"filepath": os.path.abspath(filepath)}).encode('utf-8')
    req = urllib.request.Request(
        f"{DAEMON_URL}/api/files/stage",
        data=req_data,
        headers={'Content-Type': 'application/json'},
        method='POST'
    )
    with urllib.request.urlopen(req, timeout=5) as resp:
        return json.loads(resp.read().decode('utf-8'))

def main():
    if len(sys.argv) < 2:
        print("Usage: pc-connect-send <file1> [file2] ...")
        sys.exit(1)

    files = []
    for arg in sys.argv[1:]:
        p = arg.strip()
        if p.startswith('file://'):
            p = unquote(urlparse(p).path)
        p = os.path.realpath(os.path.expanduser(p))
        if os.path.exists(p):
            files.append(p)

    if not files:
        notify("PC Connect", "No valid files selected for transfer", icon="dialog-warning")
        sys.exit(1)

    st = get_phone_status()
    if not st:
        notify("PC Connect Error", "PC Authenticator daemon is not running.", icon="dialog-error", urgency="critical")
        sys.exit(1)

    devices = st.get('devices', [])
    target_device = None

    # If only 1 device is paired, it just sends without any prompt
    if len(devices) > 1:
        target_device = choose_device_gui(devices)
        if not target_device:
            # User canceled device selection
            sys.exit(0)
    elif len(devices) == 1:
        target_device = devices[0]

    phone = st.get('phone', {})
    phone_ip = target_device.get('ip') if target_device else phone.get('ip')
    phone_port = phone.get('port', 1761)
    phone_name = target_device.get('client_name') if target_device else phone.get('client_name', 'Android Phone')

    total = len(files)
    success_count = 0

    for idx, f in enumerate(files, 1):
        fn = os.path.basename(f)
        notify("PC Connect", f"Transferring {fn} to {phone_name} ({idx}/{total})...", icon="network-transmit")
        sent = send_file(f, phone_ip, phone_port)
        if sent:
            success_count += 1

    if success_count == total:
        if total == 1:
            notify("✅ File Sent", f"Successfully sent {os.path.basename(files[0])} to {phone_name}", icon="document-save")
        else:
            notify("✅ Files Sent", f"Successfully sent {total} files to {phone_name}", icon="document-save")
    else:
        notify("⚠️ Transfer Incomplete", f"Sent {success_count}/{total} files to {phone_name}", icon="dialog-warning")

if __name__ == '__main__':
    main()
